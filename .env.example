# Copy to .env here; run npm.cmd install then npm.cmd run dev.
# Only the project URL and PUBLISHABLE (or legacy anon) key belong here.
# Never use a service-role key, database password, or Google client secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-key

# Apply supabase/migrations/202609170001_app_logic.sql to your EXISTING schema first.
# Supabase Authentication > Providers: enable Email and Google.
# Google Cloud authorized redirect URI:
# https://YOUR-PROJECT.supabase.co/auth/v1/callback
# Google client ID/secret are configured ONLY in the Supabase dashboard.
# Supabase URL Configuration: set your production Site URL, and allow:
# http://127.0.0.1:5173/auth-callback.html
# http://127.0.0.1:5173/auth-callback.html?flow=recovery
# https://YOUR-SITE/auth-callback.html (and the recovery variant)
# Configure email templates to use token_hash (NOT Token):
# Confirm signup: {{ .RedirectTo }}?token_hash={{ .TokenHash }}&type=signup
# Reset password: {{ .RedirectTo }}&token_hash={{ .TokenHash }}&type=recovery
# The reset redirect already contains ?flow=recovery; signup has no query.
# Keep recovery/confirmation URLs off analytics and logs.

# Optional DISPOSABLE database integration test project, never production.
# See tests/database.test.js. Tests create two isolated users.
# LASTTILL_TEST_SUPABASE_URL=
# LASTTILL_TEST_SERVICE_KEY=
# LASTTILL_TEST_PUBLISHABLE_KEY=
# LASTTILL_TEST_ALLOW_WRITES=yes
